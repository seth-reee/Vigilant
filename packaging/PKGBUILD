pkgname=vigilant
pkgver=0.2.1
pkgrel=1
pkgdesc='Qt startup entry manager for Omarchy'
arch=('x86_64' 'aarch64')
url='https://github.com/seth-reee/vigilant'
license=('MIT')
conflicts=('bootkeeper')
replaces=('bootkeeper')
depends=('qt6-base' 'systemd' 'polkit' 'gcc-libs' 'glibc')
optdepends=('qt6-wayland: native Wayland support' 'omarchy: theme and default editor integration')
makedepends=('cmake' 'ninja' 'gcc')
options=('!debug')
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('d08b05238e02c0a964393075d51655d5505974614599af72c588241a8d0d97bd')

build() {
  cmake -S "$srcdir/Vigilant-$pkgver" -B "build-$pkgver" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "build-$pkgver"
}

package() {
  DESTDIR="$pkgdir" cmake --install "build-$pkgver"
}
