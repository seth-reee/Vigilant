pkgname=bootkeeper
pkgver=0.1.0
pkgrel=1
pkgdesc='Qt startup entry manager for Omarchy'
arch=('x86_64')
url='https://github.com/seth-reee/bootkeeper'
license=('MIT')
depends=('qt6-base' 'systemd' 'polkit' 'gcc-libs' 'glibc')
optdepends=('qt6-wayland: native Wayland support' 'omarchy: theme and default editor integration')
makedepends=('cmake' 'ninja' 'gcc')
options=('!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cmake -S "$srcdir/$pkgname-$pkgver" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
