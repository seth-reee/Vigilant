pkgname=vigilant
pkgver=0.2.0
pkgrel=2
pkgdesc='Qt startup entry manager for Omarchy'
arch=('x86_64' 'aarch64')
url='https://github.com/seth-reee/vigilant'
license=('MIT')
conflicts=('bootkeeper')
replaces=('bootkeeper')
depends=('qt6-base' 'systemd' 'polkit' 'gcc-libs' 'glibc')
optdepends=('qt6-wayland: native Wayland support' 'omarchy: theme and default editor integration')
makedepends=('cmake' 'ninja' 'gcc')
options=('!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('f0b28eda56ca8a08009d9e25b405da9e72ec34d4d34df6ea118568621fa7ecb2')

build() {
  cmake -S "$srcdir/Vigilant-$pkgver" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
